# Gemini API Key (Can be comma-separated list of multiple keys for round-robin pooling)
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2

# TTS Model Preference
GEMINI_MODEL=gemini-3.1-flash-tts-preview

# Default Spoken Voice
DEFAULT_VOICE=Algenib

# Chunk Limits
MAX_TTS_CHARACTERS=3000
MAX_TTS_WORDS=500

# Audio Conversion
AUTO_CONVERT_MP3=true
MP3_BITRATE=320k
PRESERVE_INLINE_TAGS=true

# Output Storage Directory
OUTPUT_FOLDER=outputs
